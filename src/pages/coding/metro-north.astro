              <option value="79">Mt Pleasant</option>
              <option value="80">Hawthorne</option>
              <option value="81">Pleasantville</option>
              <option value="83">Chappaqua</option>
              <option value="84">Mt Kisco</option>
              <option value="85">Bedford Hills</option>
              <option value="86">Katonah</option>
              <option value="88">Goldens Bridge</option>
              <option value="89">Purdy's</option>
              <option value="90">Croton Falls</option>
              <option value="91">Brewster</option>
              <option value="94">Southeast</option>
              <option value="97">Patterson</option>
              <option value="98">Pawling</option>
              <option value="99">Appalachian Trail</option>
              <option value="100">Harlem Valley-Wingdale</option>
              <option value="101">Dover Plains</option>
              <option value="176">Tenmile River</option>
              <option value="177">Wassaic</option>
            </optgroup>
            <optgroup label="── Hudson Line ──">
              <option value="4">Harlem-125 St</option>
              <option value="9">Morris Heights</option>
              <option value="10">University Heights</option>
              <option value="11">Marble Hill</option>
              <option value="14">Spuyten Duyvil</option>
              <option value="16">Riverdale</option>
              <option value="17">Ludlow</option>
              <option value="18">Yonkers</option>
              <option value="19">Glenwood</option>
              <option value="20">Greystone</option>
              <option value="22">Hastings-on-Hudson</option>
              <option value="23">Dobbs Ferry</option>
              <option value="24">Ardsley-on-Hudson</option>
              <option value="25">Irvington</option>
              <option value="27">Tarrytown</option>
              <option value="29">Philipse Manor</option>
              <option value="30">Scarborough</option>
              <option value="31">Ossining</option>
              <option value="33">Croton-Harmon</option>
              <option value="37">Cortlandt</option>
              <option value="39">Peekskill</option>
              <option value="40">Manitou</option>
              <option value="42">Garrison</option>
              <option value="43">Cold Spring</option>
              <option value="44">Breakneck Ridge</option>
              <option value="46">Beacon</option>
              <option value="49">New Hamburg</option>
              <option value="51">Poughkeepsie</option>
            </optgroup>
          </select>
        </div>
        <div class="mn-sub">Live Departures</div>
      </div>
      <div>
        <div class="mn-clock" id="mn-clock">--:--:--</div>
        <div class="mn-date"  id="mn-date">---</div>
      </div>
    </div>

    <div class="mn-hero">
      <div class="mn-eyebrow">Next train — leave by</div>
      <div id="mn-hero"><div class="mn-loading"><div class="mn-spinner"></div>Loading...</div></div>
    </div>

    <div class="mn-trains-section">
      <div class="mn-section-label">Upcoming Departures</div>
      <div class="trains-grid" id="mn-trains"></div>
    </div>

    <div class="mn-refresh-bar"><div class="mn-refresh-progress" id="mn-progress" style="width:100%"></div></div>
    <div class="mn-status-bar">
      <div><span class="mn-dot" id="mn-dot"></span><span id="mn-status">Connecting...</span></div>
      <div id="mn-updated">—</div>
      <div>Auto-refresh 30s</div>
    </div>
  </div>

  <script>
    const REFRESH_MS = 30_000;
    let progressTimer = null;

    const fromEl = document.getElementById("mn-from");
    const toEl   = document.getElementById("mn-to");
    const swapEl = document.getElementById("mn-swap");

    // Build name lookup from select options
    function getStationName(id) {
      const opt = fromEl.querySelector(`option[value="${id}"]`) ||
                  toEl.querySelector(`option[value="${id}"]`);
      return opt ? opt.textContent.trim() : id;
    }

    function getAPI() {
      return `/api/trains?from=${fromEl.value}&to=${toEl.value}`;
    }

    function updateTitle() {
      document.title = `${getStationName(fromEl.value)} → ${getStationName(toEl.value)} — Zach Scholz`;
    }

    swapEl.addEventListener("click", () => {
      const tmp = fromEl.value;
      fromEl.value = toEl.value;
      toEl.value = tmp;
      updateTitle();
      fetchAndRender();
    });

    fromEl.addEventListener("change", () => { updateTitle(); fetchAndRender(); });
    toEl.addEventListener("change",   () => { updateTitle(); fetchAndRender(); });

    function tickClock() {
      const now = new Date();
      document.getElementById("mn-clock").textContent =
        now.toLocaleTimeString("en-US", { hour12: false });
      document.getElementById("mn-date").textContent =
        now.toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric" }).toUpperCase();
    }
    setInterval(tickClock, 1000);
    tickClock();

    function fmtDur(sec) {
      sec = Math.floor(sec);
      if (sec < 0)  return `${Math.floor(-sec / 60)}m ago`;
      if (sec < 60) return `${sec}s`;
      const m = Math.floor(sec / 60);
      return m < 60 ? `${m} min` : `${Math.floor(m/60)}h ${m%60}m`;
    }

    function fmtTravelTime(depTime, arrTime) {
      // Parse "H:MM PM" style times and compute difference in minutes
      if (!depTime || !arrTime) return null;
      function parseTime(t) {
        const m = t.match(/(\d+):(\d+)\s*(AM|PM)/i);
        if (!m) return null;
        let h = parseInt(m[1]);
        const min = parseInt(m[2]);
        const ap = m[3].toUpperCase();
        if (ap === "PM" && h !== 12) h += 12;
        if (ap === "AM" && h === 12) h = 0;
        return h * 60 + min;
      }
      const dep = parseTime(depTime);
      const arr = parseTime(arrTime);
      if (dep === null || arr === null) return null;
      let diff = arr - dep;
      if (diff < 0) diff += 24 * 60; // handle midnight crossover
      if (diff >= 60) {
        const h = Math.floor(diff / 60);
        const m = diff % 60;
        return m > 0 ? `${h}h ${m} min` : `${h}h`;
      }
      return `${diff} min`;
    }

    function urgency(s) {
      if (s < 0)   return "missed";
      if (s < 120) return "urgent";
      if (s < 480) return "soon";
      return "ok";
    }

    function badgeFor(urg, s) {
      if (urg === "missed") return ["badge-missed", "missed"];
      if (urg === "urgent") return ["badge-urgent", "go now"];
      if (urg === "soon")   return ["badge-soon",   "soon"];
      return ["badge-later", `in ${fmtDur(s)}`];
    }

    function renderHero(trains, data) {
      const el = document.getElementById("mn-hero");
      if (!trains.length) {
        el.innerHTML = `<div class="mn-loading" style="color:var(--mn-muted)">No upcoming trains found.</div>`;
        return;
      }

      const now         = Date.now() / 1000;
      const catchable   = trains.find(t => t.dep_ts > now);
      const comfortable = trains.find(t => t.leave_ts > now);
      const t    = catchable || trains[0];
      const next = (catchable && comfortable && comfortable.trip_id !== catchable.trip_id) ? comfortable : null;

      const leaveInSec = t.leave_ts - now;
      const depInSec   = t.dep_ts   - now;
      const urg = (leaveInSec < 0 && depInSec > 0) ? "urgent" : urgency(leaveInSec);

      // "Leave in X min" — simple countdown only
      let leaveCountdown;
      if (depInSec <= 0) {
        leaveCountdown = `Train departed ${fmtDur(depInSec)}`;
      } else if (leaveInSec < 60) {
        leaveCountdown = `<strong style="color:var(--danger)">LEAVE NOW</strong>`;
      } else {
        leaveCountdown = `Leave in <strong>${fmtDur(leaveInSec)}</strong>`;
      }

      const toName  = getStationName(toEl.value);
      const travelTime = fmtTravelTime(t.dep_time, t.arr_time);
      const travelMeta = [travelTime, t.stops_remaining ? `${t.stops_remaining} stops` : null]
        .filter(Boolean).join(" · ");

      const nextHTML = next ? `
        <div class="next-catchable">
          NEXT CATCHABLE &nbsp;·&nbsp; departs <strong>${next.dep_time}</strong>
          &nbsp;·&nbsp; leave by <strong style="color:var(--warn)">${next.leave_time}</strong>
          &nbsp;·&nbsp; in ${fmtDur(next.leave_ts - now)}
        </div>` : "";

      el.innerHTML = `
        <div class="leave-card ${urg}">
          <div>
            <div class="leave-sublabel">Leave by</div>
            <div class="leave-time ${urg}">${t.leave_time}</div>
            <div class="leave-countdown">${leaveCountdown}</div>
            <div style="margin-top:16px;">
              <div class="leave-sublabel">Train Departs</div>
              <div class="leave-time ${urg}" style="margin-top:4px;">${t.dep_time}</div>
              <div class="leave-countdown" style="margin-top:6px;">Train leaves in <strong>${fmtDur(depInSec)}</strong></div>
            </div>
            ${nextHTML}
          </div>
          <div class="divider-v" style="height:140px;"></div>
          <div class="train-detail">
            <div class="train-dest">→ ${toName}</div>
            <div class="train-dep-time">${t.arr_time || "—"}</div>
            <div class="train-meta">${travelMeta}${t.delay_minutes > 0 ? ` · <span style='color:var(--warn)'>${t.delay_minutes} min late</span>` : ""}</div>
          </div>
          <div class="walk-pill">🚶 ${data.walk_minutes + data.buffer_minutes} min to platform</div>
        </div>`;
    }

    function renderTable(trains) {
      const el    = document.getElementById("mn-trains");
      const toName = getStationName(toEl.value);
      if (!trains.length) {
        el.innerHTML = `<div class="mn-loading" style="color:var(--mn-muted)">No upcoming trains.</div>`;
        return;
      }

      const now = Date.now() / 1000;
      el.innerHTML = trains.slice(0, 8).map((t, i) => {
        const leaveInSec = t.leave_ts - now;
        const urg        = urgency(leaveInSec);
        const [bClass, bText] = badgeFor(urg, leaveInSec);
        const isNext   = i === 0 && urg !== "missed";
        const isMissed = urg === "missed";
        const delayHTML = t.delay_minutes > 0
          ? `<div class="t-delay">+${t.delay_minutes} MIN LATE</div>` : "";

        return `
          <div class="train-row ${isNext ? "is-next" : ""} ${isMissed ? "is-missed" : ""}">
            <div class="t-depart">${t.dep_time}</div>
            <div>
              <div class="t-leaveby-inline">leave by<strong>${t.leave_time}</strong></div>
              <div class="t-stops">${t.stops_remaining ? t.stops_remaining + " stops" : ""}</div>
              ${delayHTML}
            </div>
            <div class="t-gct">
              <div class="t-gct-time">${t.arr_time || "—"}</div>
              <div class="t-gct-label">arr ${toName}</div>
            </div>
            <div class="t-badge"><span class="mn-badge-pill ${bClass}">${bText}</span></div>
          </div>`;
      }).join("");
    }

    async function fetchAndRender() {
      const dot    = document.getElementById("mn-dot");
      const status = document.getElementById("mn-status");
      dot.className = "mn-dot loading";

      try {
        const res  = await fetch(getAPI());
        if (!res.ok) throw new Error(`Server error ${res.status}`);
        const data = await res.json();
        if (data.status === "error") throw new Error(data.message);

        renderHero(data.trains, data);
        renderTable(data.trains);

        dot.className = "mn-dot";
        const t = new Date(data.updated).toLocaleTimeString("en-US", { hour12: false });
        document.getElementById("mn-updated").textContent = `Updated ${t}`;
        status.textContent = `Live · ${data.trains.length} upcoming · ${getStationName(fromEl.value)}`;
      } catch (err) {
        dot.className = "mn-dot error";
        status.textContent = `Error: ${err.message}`;
        document.getElementById("mn-hero").innerHTML =
          `<div class="mn-error">⚠ Could not load feed — ${err.message}</div>`;
      }

      startProgress();
    }

    function startProgress() {
      clearInterval(progressTimer);
      let pct = 100;
      document.getElementById("mn-progress").style.width = "100%";
      progressTimer = setInterval(() => {
        pct -= 100 / (REFRESH_MS / 1000);
        if (pct < 0) pct = 0;
        document.getElementById("mn-progress").style.width = pct + "%";
      }, 1000);
    }

    fetchAndRender();
    setInterval(fetchAndRender, REFRESH_MS);
  </script>
</body>

---
// src/pages/coding/metro-north.astro
import Navbar from "../../components/Navbar.astro";
import "../../styles/global.css";
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Metro North — Zach Scholz</title>
  <meta name="description" content="Live Metro-North departures from any station to any station." />
  <link rel="icon" type="image/png" href="/icons/logo dark.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style is:global>
    #mn-root, #mn-root * { box-sizing: border-box; font-family: 'DM Sans', sans-serif; }
    #mn-root { margin: 0; }
    #mn-root p, #mn-root li, #mn-root a, #mn-root div, #mn-root span {
      font-size: unset; line-height: unset; color: unset; font-family: unset;
    }
    body { margin: 0; background: var(--bg, #0a0c0f); }

    #mn-root {
      --accent:  #00d4aa;
      --warn:    #f5c842;
      --danger:  #ff4444;
      --dim:     #374151;
      --mn-border:  var(--border, #e8e8ee);
      --mn-surface: var(--card, #f6f7f8);
      --mn-muted:   var(--muted, #6b6b6b);
      --mn-text:    var(--text, #0b0b0b);
      background: transparent;
      color: var(--text);
      min-height: calc(100vh - 120px);
      position: relative;
      width: min(95%, 1100px);
      margin: 0 auto;
      padding-bottom: 80px;
    }

    /* ── HEADER ── */
    .mn-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 0;
      border-bottom: 1px solid var(--mn-border);
      flex-wrap: wrap;
      gap: 12px;
    }
    .mn-badge {
      background: var(--accent);
      color: #000 !important;
      font-family: 'DM Mono', monospace !important;
      font-weight: 500;
      font-size: 10px !important;
      letter-spacing: 0.14em;
      padding: 3px 9px;
      border-radius: 3px;
      text-transform: uppercase;
      margin-bottom: 6px;
      display: inline-block;
      line-height: 1.4 !important;
    }
    .mn-station-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 4px;
      flex-wrap: wrap;
    }
    .mn-select {
      font-family: 'DM Mono', monospace !important;
      font-size: 16px !important;
      font-weight: 600;
      color: var(--text) !important;
      background: var(--bg) !important;
      border: none !important;
      border-bottom: 1px solid var(--mn-border) !important;
      padding: 2px 4px !important;
      cursor: pointer;
      appearance: none;
      -webkit-appearance: none;
      outline: none;
      letter-spacing: -0.01em;
      max-width: 200px;
    }
    .mn-select:focus { border-bottom-color: var(--accent) !important; }
    .mn-select option { background: var(--bg, #131313) !important; color: var(--text, #e7e7e7) !important; }
    .mn-select optgroup {
      background: var(--bg, #131313) !important;
      color: var(--accent) !important;
      font-size: 11px !important;
    }
    .mn-swap {
      background: var(--mn-surface) !important;
      border: 1px solid var(--mn-border) !important;
      color: var(--mn-muted) !important;
      font-size: 14px !important;
      padding: 2px 8px !important;
      border-radius: 4px;
      cursor: pointer;
      line-height: 1.4 !important;
      transition: color 0.15s, border-color 0.15s;
    }
    .mn-swap:hover { color: var(--accent) !important; border-color: var(--accent) !important; }
    .mn-sub {
      font-family: 'DM Mono', monospace !important;
      font-size: 10px !important;
      color: var(--mn-muted) !important;
      letter-spacing: 0.1em;
      margin-top: 6px;
      line-height: 1.4 !important;
    }
    .mn-clock {
      font-family: 'DM Mono', monospace !important;
      font-size: 30px !important;
      font-weight: 300;
      color: var(--accent) !important;
      letter-spacing: 0.04em;
      text-align: right;
      line-height: 1 !important;
    }
    .mn-date {
      font-family: 'DM Mono', monospace !important;
      font-size: 10px !important;
      color: var(--mn-muted) !important;
      margin-top: 5px;
      letter-spacing: 0.08em;
      text-align: right;
      line-height: 1.4 !important;
    }

    /* ── HERO ── */
    .mn-hero { padding: 24px 0; border-bottom: 1px solid var(--mn-border); }
    .mn-eyebrow {
      font-family: 'DM Mono', monospace !important;
      font-size: 10px !important;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--mn-muted) !important;
      margin-bottom: 12px;
      line-height: 1.4 !important;
    }
    .leave-card {
      display: flex;
      align-items: center;
      gap: 28px;
      background: transparent;
      border: 1px solid var(--mn-border);
      border-radius: 8px;
      padding: 20px 24px;
      position: relative;
      overflow: hidden;
      transition: border-color 0.3s;
    }
    .leave-card::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 3px;
      border-radius: 3px 0 0 3px;
      transition: background 0.3s;
    }
    .leave-card.ok::before     { background: var(--accent); }
    .leave-card.soon::before   { background: var(--warn); }
    .leave-card.urgent::before { background: var(--danger); }
    .leave-card.missed::before { background: var(--dim); }
    .leave-card.urgent { border-color: rgba(255,68,68,0.3); }
    .leave-card.soon   { border-color: rgba(245,200,66,0.2); }
    .leave-time {
      font-family: 'DM Mono', monospace !important;
      font-size: 48px !important;
      font-weight: 300;
      line-height: 1 !important;
      letter-spacing: -0.01em;
      transition: color 0.3s;
    }
    .leave-time.ok     { color: var(--accent) !important; }
    .leave-time.soon   { color: var(--warn) !important; }
    .leave-time.urgent { color: var(--danger) !important; }
    .leave-time.missed { color: var(--dim) !important; }
    .leave-sublabel {
      font-family: 'DM Mono', monospace !important;
      font-size: 10px !important;
      color: var(--mn-muted) !important;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 6px;
      line-height: 1.4 !important;
    }
    .leave-countdown {
      font-size: 13px !important;
      color: var(--mn-muted) !important;
      margin-top: 7px;
      font-weight: 300;
      line-height: 1.4 !important;
    }
    .leave-countdown strong { color: var(--mn-text) !important; font-weight: 500; }
    .divider-v { width: 1px; height: 64px; background: var(--mn-border); flex-shrink: 0; }
    .train-detail { flex: 1; }
    .train-dest {
      font-size: 15px !important;
      font-weight: 500;
      color: var(--mn-muted) !important;
      margin-bottom: 4px;
      line-height: 1.4 !important;
    }
    .train-dep-time {
      font-family: 'DM Mono', monospace !important;
      font-size: 48px !important;
      font-weight: 300;
      letter-spacing: -0.01em;
      color: var(--mn-text) !important;
      line-height: 1 !important;
    }
    .train-meta {
      font-family: 'DM Mono', monospace !important;
      font-size: 11px !important;
      color: var(--mn-muted) !important;
      margin-top: 6px;
      line-height: 1.4 !important;
    }
    .walk-pill {
      flex-shrink: 0;
      background: var(--mn-border);
      border-radius: 20px;
      padding: 8px 16px;
      font-family: 'DM Mono', monospace !important;
      font-size: 11px !important;
      color: var(--mn-muted) !important;
      line-height: 1.4 !important;
    }
    .next-catchable {
      margin-top: 12px;
      padding: 10px 14px;
      background: var(--mn-border);
      border-radius: 5px;
      font-family: 'DM Mono', monospace !important;
      font-size: 11px !important;
      color: var(--mn-muted) !important;
      line-height: 1.6 !important;
    }
    .next-catchable strong { color: var(--mn-text) !important; }

    /* ── TABLE ── */
    .mn-trains-section { padding: 24px 0 80px; }
    .mn-section-label {
      font-family: 'DM Mono', monospace !important;
      font-size: 10px !important;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--mn-muted) !important;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 10px;
      line-height: 1.4 !important;
    }
    .mn-section-label::after { content: ''; flex: 1; height: 1px; background: var(--mn-border); }
    .trains-grid { display: flex; flex-direction: column; gap: 6px; }
    .train-row {
      display: grid;
      grid-template-columns: 100px 1fr 110px 70px;
      align-items: center;
      gap: 16px;
      padding: 13px 18px;
      background: var(--mn-surface);
      border: 1px solid var(--mn-border);
      border-radius: 6px;
      transition: border-color 0.2s;
    }
    .train-row.is-next   { border-color: var(--accent); background: rgba(0,212,170,0.04); }
    .train-row.is-missed { opacity: 0.4; }
    .t-depart {
      font-family: 'DM Mono', monospace !important;
      font-size: 20px !important;
      font-weight: 400;
      color: var(--mn-text) !important;
      line-height: 1.2 !important;
    }
    .train-row.is-next .t-depart { color: var(--accent) !important; }
    .t-leaveby-inline {
      font-family: 'DM Mono', monospace !important;
      font-size: 11px !important;
      color: var(--mn-muted) !important;
      line-height: 1.4 !important;
    }
    .t-leaveby-inline strong { color: var(--mn-text) !important; display: block; font-size: 14px !important; }
    .t-stops { font-size: 12px !important; color: var(--mn-muted) !important; margin-top: 2px; line-height: 1.4 !important; }
    .t-delay {
      font-family: 'DM Mono', monospace !important;
      font-size: 10px !important;
      color: var(--warn) !important;
      margin-top: 2px;
      line-height: 1.4 !important;
    }
    .t-gct { text-align: center; }
    .t-gct-time { font-family: 'DM Mono', monospace !important; font-size: 13px !important; color: var(--mn-muted) !important; line-height: 1.4 !important; }
    .t-gct-label { font-family: 'DM Mono', monospace !important; font-size: 9px !important; color: var(--dim) !important; text-transform: uppercase; letter-spacing: 0.1em; margin-top: 2px; line-height: 1.4 !important; }
    .t-badge { text-align: right; }
    .mn-badge-pill {
      display: inline-block;
      font-family: 'DM Mono', monospace !important;
      font-size: 10px !important;
      letter-spacing: 0.08em;
      padding: 3px 8px;
      border-radius: 3px;
      text-transform: uppercase;
      line-height: 1.4 !important;
    }
    .badge-ok     { background: rgba(0,212,170,0.12); color: var(--accent) !important; }
    .badge-soon   { background: rgba(245,200,66,0.12); color: var(--warn) !important; }
    .badge-urgent { background: rgba(255,68,68,0.12);  color: var(--danger) !important; }
    .badge-later  { background: var(--mn-border); color: var(--mn-muted) !important; }
    .badge-missed { border: 1px solid var(--mn-border); color: var(--dim) !important; }

    /* ── STATUS BAR ── */
    .mn-status-bar {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      background: var(--mn-surface);
      border-top: 1px solid var(--mn-border);
      padding: 10px clamp(12px, 5vw, calc((100vw - min(95%, 1100px)) / 2));
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-family: 'DM Mono', monospace !important;
      font-size: 10px !important;
      color: var(--mn-muted) !important;
      letter-spacing: 0.06em;
      z-index: 50;
    }
    .mn-dot { width: 6px; height: 6px; border-radius: 50%; display: inline-block; margin-right: 7px; background: var(--accent); animation: mn-pulse 2s infinite; }
    .mn-dot.error   { background: var(--danger); animation: none; }
    .mn-dot.loading { background: var(--warn); }
    @keyframes mn-pulse { 0%,100%{opacity:1} 50%{opacity:0.25} }
    .mn-refresh-bar { position: fixed; bottom: 37px; left: 0; right: 0; height: 2px; background: var(--mn-border); z-index: 49; }
    .mn-refresh-progress { height: 100%; background: var(--accent); opacity: 0.35; transition: width 1s linear; }
    .mn-loading { display: flex; align-items: center; gap: 12px; color: var(--mn-muted) !important; font-family: 'DM Mono', monospace !important; font-size: 12px !important; padding: 24px 0; }
    .mn-spinner { width: 20px; height: 20px; border: 2px solid var(--mn-border); border-top-color: var(--accent); border-radius: 50%; animation: mn-spin 0.8s linear infinite; flex-shrink: 0; }
    @keyframes mn-spin { to { transform: rotate(360deg); } }
    .mn-error { background: rgba(255,68,68,0.06); border: 1px solid rgba(255,68,68,0.2); border-radius: 8px; padding: 20px 24px; font-family: 'DM Mono', monospace !important; font-size: 12px !important; color: var(--danger) !important; line-height: 1.8 !important; }

    @media (max-width: 600px) {
      .mn-header, .mn-hero, .mn-trains-section { padding-left: 16px; padding-right: 16px; }
      .mn-clock { font-size: 20px !important; }
      .leave-time { font-size: 36px !important; }
      .train-dep-time { font-size: 36px !important; }
      .leave-card { gap: 16px; flex-wrap: wrap; }
      .train-row { grid-template-columns: 90px 1fr 90px; }
      .t-badge { display: none; }
    }
  </style>
</head>
